# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
OWNER_ID=your_telegram_user_id

# LLM API (OpenAI compatible, Clouvia Router, etc.)
API_KEY=your_api_key_here
BASE_URL=https://router.clouvia.id/v1
MODEL=deepseek-v4.1-flash

# PostgreSQL (Memory & Config). Tabel dibuat otomatis dari schema.sql saat bot start.
# Untuk managed DB yang mewajibkan TLS, tambahkan ?sslmode=require di ujung URL.
DATABASE_URL=postgres://user:password@localhost:5432/nroz

TAVILY_API_KEY=
# Opsional — semua sudah punya nilai bawaan di kode, isi hanya kalau mau beda.
# Batas ukuran video yang masih dikirim ke chat sebagai video native; di atas ini
# dikirim sebagai link unduhan (Bot API menolak upload > 50 MB).
#TELEGRAM_SEND_MAX_MB=48
#VIDEO_SHARE_PORT=4789
#VIDEO_SHARE_TTL_HOURS=72
# Batas durasi render dan kalibrasi kecepatan (detik per frame, makin kecil makin optimis).
#REMOTION_MAX_RENDER_SECONDS=900
#REMOTION_FRAME_SECONDS=0.35
#REMOTION_RENDER_TIMEOUT_MS=
