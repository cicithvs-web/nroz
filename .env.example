# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
OWNER_ID=your_telegram_user_id

# LLM API (OpenAI compatible, Clouvia Router, etc.)
API_KEY=your_api_key_here
BASE_URL=https://router.clouvia.id/v1
MODEL=deepseek-v4.1-flash
# Opsional: satu atau beberapa model cadangan (dipisah spasi) bila model utama timeout/limit
FALLBACK_MODEL=glm/glm-5.3-flash

# PostgreSQL (Memory & Config). Tabel dibuat otomatis dari schema.sql saat bot start.
# Untuk managed DB yang mewajibkan TLS, tambahkan ?sslmode=require di ujung URL.
# Catatan: fitur memori semantik (RAG) butuh ekstensi pgvector — docker-compose.yml repo ini
# sudah memakai image pgvector/pgvector:pg16.
DATABASE_URL=postgres://user:password@localhost:5432/nroz

# --- Memori semantik / RAG (tool search_knowledge) ---
# Embedding memakai BASE_URL + API_KEY di atas. Sesuaikan EMBED_MODEL dengan yang didukung
# penyedia API-mu, dan EMBED_DIM dengan dimensi vektornya (text-embedding-3-small = 1536).
#EMBED_MODEL=text-embedding-3-small
#EMBED_DIM=1536
# Matikan indeks percakapan otomatis (dokumen upload tetap diindeks): set ke off
#KNOWLEDGE_INGEST_CHAT=on

# --- Webhook masuk (event eksternal -> notif chat / agent) ---
# Server hook selalu menempel di 127.0.0.1; URL publik dibuka lewat /webhookurl (Cloudflare Tunnel).
#WEBHOOK_PORT=4790
#WEBHOOK_TUNNEL_HOURS=720

# --- Tugas agent terjadwal & ask_user ---
#AGENT_TASK_MAX_PER_SESSION=20
#ASK_USER_DEFAULT_MINUTES=10

# --- Analisis video referensi (analyze_video_reference) ---
# Durasi awal video yang dianalisis (detik), batas waktu satu panggilan vision (ms),
# dan panjang maksimal laporan yang dikirim ke model (karakter).
#VIDEO_REF_MAX_SECONDS=120
#VIDEO_REF_VISION_TIMEOUT_MS=120000
#VIDEO_REF_MAX_REPORT_CHARS=8000

# --- Terminal streaming (live tail job background) ---
# off = matikan live tail; TERMINAL_STREAM_STOP=off = matikan tombol stop native (Bot API 10.3)
#TERMINAL_STREAM=on
#TERMINAL_STREAM_STOP=on
#TERMINAL_STREAM_DRAFT_MS=1500
#TERMINAL_STREAM_EDIT_MS=5000

TAVILY_API_KEY=
# Opsional — semua sudah punya nilai bawaan di kode, isi hanya kalau mau beda.
# Batas ukuran video yang masih dikirim ke chat sebagai video native; di atas ini
# dikirim sebagai link unduhan (Bot API menolak upload > 50 MB).
#TELEGRAM_SEND_MAX_MB=48
#VIDEO_SHARE_PORT=4789
#VIDEO_SHARE_TTL_HOURS=72
# Batas durasi render dan kalibrasi kecepatan (detik per frame, makin kecil makin optimis).
#REMOTION_MAX_RENDER_SECONDS=900
#REMOTION_FRAME_SECONDS=0.35
#REMOTION_RENDER_TIMEOUT_MS=
