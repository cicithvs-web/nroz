FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    wget \
    git \
    unzip \
    zip \
    python3 \
    python3-pip \
    python3-venv \
    python3-matplotlib \
    nodejs \
    npm \
    build-essential \
    jq \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["tail", "-f", "/dev/null"]
