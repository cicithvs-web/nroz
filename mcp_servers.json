{
  "mcpServers": {
    "browser": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--no-sandbox",
        "--browser",
        "chromium",
        "--blocked-origins",
        "localhost*;*.localhost*;127.*;0.0.0.0*;10.*;192.168.*;169.254.*;100.64.*;172.16.*;172.17.*;172.18.*;172.19.*;172.20.*;172.21.*;172.22.*;172.23.*;172.24.*;172.25.*;172.26.*;172.27.*;172.28.*;172.29.*;172.30.*;172.31.*;[::1]*;[fc*;[fd*;[fe80*"
      ],
      "env": {}
    },
    "sequential_thinking": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "toolPrefix": "",
      "env": {}
    }
  }
}
