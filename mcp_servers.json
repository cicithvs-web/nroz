{
  "mcpServers": {
    "browser": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--no-sandbox",
        "--browser",
        "chromium"
      ],
      "env": {}
